<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
  </head>
  <body class="portfolio-site">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="portfolio-shell">
      {% include portfolio-sidebar.liquid %}
      <div class="portfolio-reading">
        <main id="main-content" tabindex="-1">{{ content }}</main>
        <footer class="portfolio-footer">
          <span>&copy; {{ site.time | date: '%Y' }} Daniela Occhipinti</span>
          <a href="{{ '/cv/' | relative_url }}">CV</a>
          <a href="{{ '/publications/' | relative_url }}">Publications</a>
          <a href="{{ '/news/' | relative_url }}">Milestones</a>
        </footer>
      </div>
    </div>
    {% include scripts.liquid %}
    <script defer src="{{ '/assets/js/portfolio.js' | relative_url | bust_file_cache }}"></script>
  </body>
</html>
