{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <label for="bibsearch" class="sr-only">Filter publications</label>
  <input type="text" id="bibsearch" spellcheck="false" autocomplete="off" class="search bibsearch-form-input" placeholder="Type to filter" aria-describedby="bibsearch-status">
  <p id="bibsearch-status" class="search-status" aria-live="polite" hidden>No publications match this filter. Try a title, venue, year, or author keyword.</p>
{% endif %}
